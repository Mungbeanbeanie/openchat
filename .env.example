# Copy to .env and fill in once your Meta app + Supabase project exist.
# Everything here is OPTIONAL for local dev: the simulator and tests run with no values.

# --- Meta / Instagram (Instagram API with Instagram Login) ---
META_APP_ID=
META_APP_SECRET=
# Any string you pick; you enter the same value in the Meta webhook config.
META_VERIFY_TOKEN=
# Graph API version to target.
META_GRAPH_VERSION=v23.0
# Must exactly match the redirect URI registered in the Meta app.
META_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/instagram/callback

# --- Supabase ---
SUPABASE_URL=
# Service-role key (server-side only — bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
